# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Artemis (AI Android automation) - external tool clone, has its own venv/secrets
/tools/artemis/

# Agent/tool session state and caches - not project source
/.omc/
/.playwright-mcp/
/.superpowers/

# Llave de firma de la app y sus contraseñas. NUNCA deben subirse: quien tenga
# el .jks y la contraseña puede publicar actualizaciones falsas de Wuarikes.
# Si se pierde la llave, la app no se puede volver a actualizar en Play Store.
*.jks
*.keystore
/android/key.properties

# Estado de herramientas en cualquier carpeta
**/.omc/
build_errors.txt

# Llaves que se pasan al compilar (--dart-define-from-file)
dart_defines.json
